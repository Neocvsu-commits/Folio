{
  "name": "folio-bilingual",
  "version": "0.1.0",
  "description": "对页 · 为原文阅读制作短句双语 EPUB",
  "author": "Folio",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "build": "npm run typecheck && vite build && node scripts/build.mjs",
    "start": "electron .",
    "package": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "entities": "^6.0.1",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "sharp": "^0.34.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "build": {
    "appId": "com.folio.bilingual",
    "productName": "Folio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/icon.png",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "portable",
      "icon": "assets/icon.png",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Folio-0.1.0-Windows.exe"
    }
  }
}
